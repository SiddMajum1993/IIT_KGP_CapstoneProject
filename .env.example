# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is gitignored. Never commit real keys, URLs or certificates.
# Anything still in <angle brackets> is treated as unset.

# --- Local LLM (Ollama) -------------------------------------------------------------
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:8b-fp16

# --- Course inference API (used with --backend class) ------------------------------
LLM_BASE_URL=<https://your-inference-endpoint/v1>
LLM_MODEL=Qwen/Qwen3-8B
# Either put the key here, or point LLM_API_KEY_FILE at a file that holds it.
LLM_API_KEY=<your-api-key>
LLM_API_KEY_FILE=<path/to/api_key.txt>
# CA certificate for the endpoint's HTTPS, if your provider issued one.
LLM_CA_CERT=<path/to/ca.crt>

# --- Embedding API (Week 2 RAG) -----------------------------------------------------
EMBEDDING_BASE_URL=<https://your-embedding-endpoint/v1>
EMBEDDING_MODEL=<embedding-model-name>
EMBEDDING_API_KEY=<your-embedding-api-key>
EMBEDDING_API_KEY_FILE=<path/to/embedding_key.txt>
EMBEDDING_CA_CERT=<path/to/embedding_ca.crt>

# --- LLM judge (local Ollama) -------------------------------------------------------
JUDGE_BASE_URL=http://localhost:11434
JUDGE_MODEL=gemma3:27b
